    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "baseline-browser-mapping": "^2.9.19",
    "jsdom": "^26.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": "20.x"
  }
