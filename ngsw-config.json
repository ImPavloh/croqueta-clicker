{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "critical-assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/fonts/*.woff2",
          "/assets/fonts/*.woff",
          "/assets/fonts/*.ttf",
          "/assets/fonts/*.otf",
          "/assets/i18n/*.json",
          "/assets/backgrounds/bg.webp",
          "/assets/skins/croqueta-normal.webp",
          "/assets/skins/croqueta-normal-mid.webp",
          "/assets/skins/croqueta-normal-low.webp",
          "/assets/skins/croqueta-dorada.webp",
          "/assets/effects/*.webp",
          "/assets/logo/*.webp",
          "/assets/icons/**",
          "/assets/**/*.svg",
          "/assets/**/*.cur"
        ]
      }
    },
    {
      "name": "media-and-extras",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**/*.webp",
          "/assets/**/*.png",
          "/assets/**/*.apng",
          "/assets/**/*.avif",
          "/assets/**/*.jpg",
          "/assets/**/*.jpeg",
          "/assets/**/*.gif",
          "/assets/**/*.mp3",
          "/assets/**/*.ogg",
          "/assets/**/*.wav"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "leaderboard-api",
      "urls": ["https://cosvywlgllqpnqdrphtt.supabase.co/rest/v1/leaderboard*"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 20,
        "maxAge": "15m",
        "timeout": "5s"
      }
    }
  ]
}
